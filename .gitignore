# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- devenv (claude_basement) ---
# エージェントの実行記録。作業をあとから確認するためのローカル専用ログで、
# 成果物ではないためコミットしない。
/.claude/logs/

# --- このプロジェクト固有 ---
# TRPGルールブック由来の資料。権利者以外が再配布できないため、
# publicリポジトリに含めない。ローカルには残り、エージェントは参照できる。
# アプリ本体(index.html)はこのフォルダに依存しないため、除外しても動作に影響はない。
/knowledge/

# ブラウザ操作ツール(Playwright MCP)が動作確認時に吐く一時ファイル
/.playwright-mcp/
