{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "フックを Perl で動かす構成。Node が無い環境でも動く（Perl は git に同梱されている）。",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(*.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(bat *.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "perl .claude/hooks/guard-commands.pl" },
          { "type": "command", "command": "perl .claude/hooks/audit-log.pl" }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "perl .claude/hooks/audit-log-edit.pl" }]
      }
    ]
  }
}
