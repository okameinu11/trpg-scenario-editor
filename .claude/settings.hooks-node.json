{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "フックを Node で動かす構成。Perl がフックの起動シェルから解決できない場合はこちらを使う。",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(*.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(bat *.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-commands.js" },
          { "type": "command", "command": "node .claude/hooks/audit-log.js" }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/audit-log-edit.js" }]
      }
    ]
  }
}
